# CLS RAG+CAG — config for the generative "💬 Answer with gpt-oss-120b" answer.
#
# OpenRouter · openai/gpt-oss-120b is now the DEFAULT carrier and the answer is ON by
# default — the app already knows the URL and model, so plug-and-play is just your key:
#
#   1. cp cls.env.example cls.env
#   2. paste your OpenRouter key on the CLS_DLLM_API_KEY line below
#   3. ./scripts/launch_cls.sh   (it auto-sources cls.env if present; cls.env is gitignored)
#
# Any OpenAI-compatible endpoint works. To switch carriers, change the URL/model below.

# --- OpenRouter (default carrier) -----------------------------------------------------
# URL + model match the app defaults; you only NEED to paste your key.
export CLS_DLLM_API_KEY=
# export CLS_DLLM_API_URL=https://openrouter.ai/api/v1
# export CLS_DLLM_MODEL=openai/gpt-oss-120b

# --- Alternatives — uncomment one block and comment the OpenRouter one above ----------

# Ollama (local, private, no key — pull a small fast model first: `ollama pull llama3.2`)
# export CLS_DLLM_API_URL=http://localhost:11434/v1
# export CLS_DLLM_MODEL=llama3.2

# Groq (fast hosted inference for gpt-oss)
# export CLS_DLLM_API_URL=https://api.groq.com/openai/v1
# export CLS_DLLM_API_KEY=gsk_your-key-here
# export CLS_DLLM_MODEL=openai/gpt-oss-120b
