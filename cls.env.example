# CLS RAG+CAG — local dev config for the generative "💬 Answer with LLM" toggle.
#
#   1. cp cls.env.example cls.env
#   2. paste your API key below
#   3. ./launch_cls.sh   (it auto-sources cls.env if present; cls.env is gitignored)
#
# Any OpenAI-compatible endpoint works. Default below is OpenRouter (100+ models, one key).

# --- OpenRouter (default) -------------------------------------------------------------
export CLS_DLLM_API_URL=https://openrouter.ai/api/v1
export CLS_DLLM_API_KEY=sk-or-your-key-here
export CLS_DLLM_MODEL=openai/gpt-oss-120b

# --- Alternatives — uncomment one block and comment the OpenRouter one above ----------

# Ollama (local, private, no key — pull a small fast model first: `ollama pull llama3.2`)
# export CLS_DLLM_API_URL=http://localhost:11434/v1
# export CLS_DLLM_MODEL=llama3.2

# Groq (fast hosted inference for gpt-oss)
# export CLS_DLLM_API_URL=https://api.groq.com/openai/v1
# export CLS_DLLM_API_KEY=gsk_your-key-here
# export CLS_DLLM_MODEL=openai/gpt-oss-120b
